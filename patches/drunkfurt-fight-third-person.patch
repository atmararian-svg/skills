+    const name = `${m.name} ${src.name}`;
+    let mat: MeshStandardMaterial;
+    if (/beard|moustache/i.test(name)) mat = keep(shaded('#5a4a44', { map: src.map, cards: true, gain: 1, rim: 0.8 }));
